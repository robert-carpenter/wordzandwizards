# Browser bundle: safe to expose
VITE_DISCORD_CLIENT_ID=
# Optional override. If omitted, the website derives Discord's standard
# installation link from VITE_DISCORD_CLIENT_ID.
VITE_DISCORD_INSTALL_URL=

# Server only: configure in your secret manager or ignored .env file
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
SESSION_SECRET=

# Runtime
NODE_ENV=development
PORT=3000

# Optional comma-separated tunnel/development origins
ACTIVITY_ALLOWED_ORIGINS=

# Development harness only. Prefer `npm run dev:activity-test`, which sets
# these flags and creates an ephemeral session secret automatically.
# VITE_ACTIVITY_TEST_MODE=true
# ACTIVITY_TEST_MODE=true
